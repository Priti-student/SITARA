# ─────────────────────────────────────────────────────────────
# SITARA server configuration template
# Copy to .env and fill real values locally. NEVER commit .env
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# PostgreSQL connection (local service)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/sitara

# JWT signing secrets — use long random values (e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
# Access token lifetime in seconds (900 = 15 minutes)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# CORS: comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Bootstrap super admin account (consumed by `prisma db seed` only)
ADMIN_EMAIL=admin@sitara.gov.in
ADMIN_PASSWORD=CHANGE_ME